{
  "name": "dsh-evidence-pages",
  "version": "0.2.0",
  "description": "Source-addressed tool results and selective verbatim checkpoints for DSH rc.5",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.9"
  },
  "main": "./page.js",
  "exports": {
    ".": "./page.js",
    "./engine": "./engine.js",
    "./pruner": "./pruner.js",
    "./policy": "./policy.js",
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "cordis.patch.yml",
    "preset",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-force-exit test/*.test.mjs"
  },
  "dsh": { "manifestVersion": 1, "bundle": { "patch": "./cordis.patch.yml" } },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.5",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5"
  }
}
